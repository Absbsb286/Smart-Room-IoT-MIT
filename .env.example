# Salin file ini jadi .env lalu isi nilainya (jangan commit .env)
# MQTT - broker EMQX yang sama dengan smart-room-iot-server
MQTT_HOST=broker.emqx.io
MQTT_PORT=8883
MQTT_USERNAME=ISI_USERNAME
MQTT_PASSWORD=ISI_PASSWORD
MQTT_CLIENT_ID=smartroom-mit-bridge-001
MQTT_TLS=true

# Device / topik
DEVICE_ID=room1

# Token untuk aplikasi App Inventor (isi di TextBox12)
MOBILE_TOKEN=ISI_TOKEN_RANDOM

# CORS allowlist (opsional). Kosong = tanpa header CORS.
# Pisahkan dengan koma bila ada dashboard web yang perlu memanggil bridge.
ALLOWED_ORIGINS=

# Port (Render menyediakan PORT otomatis)
PORT=3002
